# Streamlit secrets template. Copy to `secrets.toml` and fill in.
# Streamlit loads this automatically; do not commit `secrets.toml`.

# [data]
# Optional API keys for alternative data providers (none required for the
# bundled synthetic universe).
# fred_api_key = ""
# tiingo_api_key = ""

# [feature_flags]
# Toggle slow features for hosted demos.
# enable_real_data = false
# enable_long_backtests = false
